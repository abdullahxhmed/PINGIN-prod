generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS 

enum ContactEndpointType {
  PHONE
}

enum communicationCallStatus {
  INITIATED
  INCOMING
  CONNECTED
  COMPLETED
  MISSED
}

enum CommunicationSessionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
}

enum CommunicationSessionType {
  CALL
  ALERT
  MESSAGE
}

enum ResourceType{
  VEHICLE
  PROPERTY
  EQUIPMENT
  OTHER
}

// DATABASE TABLES

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  mobileNumber String   @unique
  passwordHash String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contactEndpoint ContactEndpoint?
  resources       Resource[]
  refreshTokens   RefreshToken[]
}

model ContactEndpoint {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  type        ContactEndpointType
  phoneNumber String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  communicationSessions CommunicationSession[]
}

model Resource {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  active    Boolean  @default(true)
  type ResourceType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  contactLink           ContactLink?
  communicationSessions CommunicationSession[]
  vehicleDetail VehicleDetail?
}


model VehicleDetail {
  id String @id @default(uuid()) @db.Uuid
  resourceId String @db.Uuid @unique
  registrationNum String?
  vehicleColour String?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}
model ContactLink {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @unique @db.Uuid
  token      String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  communicationSessions CommunicationSession[]
}

model CommunicationSession {
  id                   String @id @default(uuid()) @db.Uuid
  reference            String @unique
  resourceId           String @db.Uuid
  type CommunicationSessionType 
  contactLinkId        String @db.Uuid
  contactEndpointId    String @db.Uuid
  contactorPhoneNumber String

  status    CommunicationSessionStatus @default(PENDING)
  expiresAt DateTime?
  endedAt   DateTime?

  provider  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resource        Resource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  contactLink     ContactLink     @relation(fields: [contactLinkId], references: [id], onDelete: Restrict)
  contactEndpoint ContactEndpoint @relation(fields: [contactEndpointId], references: [id], onDelete: Restrict)

  calls CommunicationCall[]

  @@index([resourceId])
  @@index([contactLinkId])
  @@index([contactEndpointId])
}

model CommunicationCall {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  callSid   String @unique

  caller         String
  callee         String
  direction      String?
  status         communicationCallStatus
  providerStatus String?

  durationSec Int?
  incomingAt   DateTime?
  connectedAt  DateTime?
  endedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session CommunicationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model EdesyWebhookEvent {
  id        String  @id @default(uuid()) @db.Uuid
  event     String
  reference String?
  callSid   String?
  payload   Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([reference])
  @@index([callSid])
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  mobileNumber String
  otpHash      String
  purpose      OtpPurpose
  expiresAt    DateTime
  attempts     Int        @default(0)
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
